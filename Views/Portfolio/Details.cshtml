@model ArtGallery.Models.Painting
@{
    ViewBag.Title = Model.GetTitle(ViewBag.Culture);
}

<section class="section">
    <div class="container">
        <a href="/Portfolio" class="back-link">← @ViewBag.Loc["Portfolio"]</a>
        
        <div class="painting-details">
            <div class="painting-details-image">
                <img src="@Model.ImageUrl" alt="@Model.GetTitle(ViewBag.Culture)" onerror="this.src='/images/placeholder.jpg'" />
            </div>
            <div class="painting-details-info">
                <h1 class="painting-details-title">@Model.GetTitle(ViewBag.Culture)</h1>
                <p class="painting-details-description">@Model.GetDescription(ViewBag.Culture)</p>
                
                <div class="painting-specs">
                    <div class="spec-row">
                        <span class="spec-label">@ViewBag.Loc["Year"]:</span>
                        <span class="spec-value">@Model.Year</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">@ViewBag.Loc["Size"]:</span>
                        <span class="spec-value">@Model.Size</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">@ViewBag.Loc["Technique"]:</span>
                        <span class="spec-value">@Model.GetTechnique(ViewBag.Culture)</span>
                    </div>
                </div>

                <div class="painting-details-price">
                    <span class="price-amount">@Model.Price.ToString("N0") @ViewBag.Loc["Currency"]</span>
                    @if (Model.IsAvailable)
                    {
                        <span class="availability available">@ViewBag.Loc["Available"]</span>
                    }
                    else
                    {
                        <span class="availability sold">@ViewBag.Loc["Sold"]</span>
                    }
                </div>

                @if (Model.IsAvailable)
                {
                    <div class="painting-actions">
                        <button class="btn btn-primary btn-large add-to-cart" data-id="@Model.Id">@ViewBag.Loc["AddToCart"]</button>
                        <a href="/Shop/Details/@Model.Id" class="btn btn-secondary btn-large">@ViewBag.Loc["Buy"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
